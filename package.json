{
  "name": "reciclaplus-playwright",
  "version": "1.0.0",
  "description": "Testes E2E do Recicla+ com Playwright (pilha isolada: Postgres temporário + API + front)",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "typecheck": "tsc",
    "install:browsers": "playwright install chromium"
  },
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63",
    "@types/node": "^24.19.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
